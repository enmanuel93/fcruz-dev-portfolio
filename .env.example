# EmailJS credentials for the contact form (https://www.emailjs.com).
# Copy this file to .env.local and fill in the values; .env.local is never committed.
# All three are required: without them the form shows an error instead of sending.

# Email Services tab: ID of the service connected to your inbox (e.g. service_abc123).
VITE_EMAILJS_SERVICE_ID=

# Email Templates tab: ID of the template the form fills in (e.g. template_abc123).
# The template must use the variables {{from_name}}, {{from_email}} and {{message}}.
VITE_EMAILJS_TEMPLATE_ID=

# Account > General: your Public Key. It ends up in the browser bundle by design;
# protect it by allowing only your domain in EmailJS's security settings.
VITE_EMAILJS_PUBLIC_KEY=
